<% content_for :title, "Restyle My Space — See Your Home in Any Architecture Style" %>
<% content_for :meta_description, "Upload a photo of your home or a room and see it re-imagined in any of #{@styles.size} architecture styles — Mid-Century Modern, Craftsman, Brutalism, and more." %>

<style>
  .restyle-card {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 28px 24px;
    max-width: 620px;
    margin: 0 auto;
  }
  .restyle-space-toggle input[type="radio"] { display: none; }
  .restyle-space-toggle label {
    display: inline-block;
    padding: 8px 18px;
    border: 1px solid #0056b3;
    color: #0056b3;
    background: #fff;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    margin: 0;
  }
  .restyle-space-toggle label:first-of-type { border-radius: 6px 0 0 6px; }
  .restyle-space-toggle label:last-of-type { border-radius: 0 6px 6px 0; margin-left: -1px; }
  .restyle-space-toggle input[type="radio"]:checked + label {
    background: #0056b3;
    color: #fff;
  }
  .restyle-submit {
    background: #0056b3;
    color: #fff;
    border: none;
    border-radius: 6px;
    padding: 12px 28px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
  }
  .restyle-submit:hover:not(:disabled) { background: #004080; }
  .restyle-submit:disabled { background: #a8c6e5; cursor: not-allowed; }
  .restyle-file-label {
    display: inline-block;
    padding: 10px 20px;
    background: #fff;
    color: #0056b3;
    border: 1px solid #0056b3;
    border-radius: 6px;
    font-weight: 600;
    cursor: pointer;
  }
</style>

<div class="text-center" style="margin-bottom: 24px;">
  <h1 style="color: #01161e;">Restyle My Space 🏠</h1>
  <p style="color: #4b5563; max-width: 560px; margin: 0 auto;">
    Upload a photo of your home's exterior or a room, pick an architecture style,
    and see what your actual space would look like re-designed in that style.
  </p>
</div>

<% if user_signed_in? || @guest_trial_available %>
  <div class="restyle-card">
    <%= form_with url: restyle_path, method: :post, local: true, multipart: true do |form| %>
      <div class="text-center" style="margin-bottom: 20px;">
        <%= form.file_field :image, accept: "image/jpeg,image/png,image/webp", id: "restyle-image-input", style: "display: none;", onchange: "restylePreview(event)" %>
        <label for="restyle-image-input" class="restyle-file-label">Choose a Photo</label>
        <p style="color: #6c757d; font-size: 12.5px; margin-top: 8px;">JPG, PNG, or WebP · up to 15 MB</p>
        <img id="restyle-preview" alt="Your photo" style="display: none; max-width: 100%; max-height: 420px; border-radius: 8px; margin-top: 8px;">
      </div>

      <div class="text-center restyle-space-toggle" style="margin-bottom: 20px;">
        <input type="radio" name="space_type" value="exterior" id="space-exterior" <%= 'checked' if @preselected_space != 'interior' %>>
        <label for="space-exterior">Home exterior</label>
        <input type="radio" name="space_type" value="interior" id="space-interior" <%= 'checked' if @preselected_space == 'interior' %>>
        <label for="space-interior">Interior room</label>
      </div>

      <div style="max-width: 380px; margin: 0 auto 22px;">
        <label for="style_name" style="font-weight: 600; color: #333; font-size: 14px;">Architecture style</label>
        <%= select_tag :style_name,
              options_for_select(@styles, @preselected_style),
              include_blank: 'Choose a style…',
              required: true,
              style: "width: 100%; padding: 9px 12px; border: 1px solid #dee2e6; border-radius: 6px; font-size: 14.5px; margin-top: 4px;" %>
        <small style="color: #6c757d; font-size: 12px;">
          Not sure which you like? <%= link_to 'Find your style first', style_finder_path, style: 'color: #0056b3;' %>
          or <%= link_to 'browse examples', styles_index_path, style: 'color: #0056b3;' %>.
        </small>
      </div>

      <div class="text-center">
        <%= form.submit "Restyle My Space", class: "restyle-submit", id: "restyle-submit-btn", disabled: true, title: "Add a photo and pick a style first" %>
        <% if !user_signed_in? %>
          <p style="color: #6c757d; font-size: 13px; margin-top: 10px;">
            Your first restyle is free — no account needed.
          </p>
        <% elsif current_user.subscription_status != 'active' %>
          <p style="color: #6c757d; font-size: 13px; margin-top: 10px;">
            Uses 1 credit — you have <%= current_user.credits %> left.
            <%= link_to 'Go unlimited', pricing_path(src: 'restyle_form'), style: 'color: #0056b3; font-weight: 600;' %>
          </p>
        <% end %>
      </div>
    <% end %>
  </div>

  <script>
    function restyleUpdateSubmit() {
      var file = document.getElementById('restyle-image-input').files.length > 0;
      var style = document.getElementById('style_name').value !== '';
      var btn = document.getElementById('restyle-submit-btn');
      btn.disabled = !(file && style);
      btn.title = btn.disabled ? 'Add a photo and pick a style first' : '';
    }
    function restylePreview(event) {
      var file = event.target.files[0];
      if (file) {
        var img = document.getElementById('restyle-preview');
        img.src = URL.createObjectURL(file);
        img.style.display = 'block';
      }
      restyleUpdateSubmit();
    }
    document.getElementById('style_name').addEventListener('change', restyleUpdateSubmit);
  </script>
<% else %>
  <div class="restyle-card text-center">
    <h2 style="font-size: 20px; color: #1f2937; margin-bottom: 8px;">You've used your free restyle</h2>
    <p style="color: #4b5563; font-size: 14.5px; margin-bottom: 18px;">
      Create a free account for another credit — or go
      <%= link_to 'Pro', pricing_path(src: 'restyle_trial_used'), style: 'color: #0056b3; font-weight: 600;' %>
      for unlimited restyles, analyses, and AI designs.
    </p>
    <%= link_to "Create Free Account", new_user_registration_path, class: "btn", style: "background: #0056b3; color: #fff; padding: 10px 22px; border-radius: 6px; font-weight: 600;" %>
    <p style="margin-top: 12px; font-size: 13px;"><%= link_to "Already have an account? Sign in", new_user_session_path, style: "color: #0056b3;" %></p>
  </div>
<% end %>

<div class="text-center" style="margin: 34px auto 10px; max-width: 620px;">
  <h3 style="font-size: 16px; color: #01161e; margin-bottom: 10px;">How it works</h3>
  <p style="color: #6b7280; font-size: 13.5px;">
    1. Upload a photo of your home or a room &nbsp;·&nbsp; 2. Pick from <%= @styles.size %> architecture styles
    &nbsp;·&nbsp; 3. AI re-renders <em>your</em> space in that style — same layout, same angle, new design language.
  </p>
</div>
