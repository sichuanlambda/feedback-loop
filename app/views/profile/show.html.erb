.level-badge.beginner { background: #e8f5e8; color: #2e7d32; }
.level-badge.intermediate { background: #fff3e0; color: #ef6c00; }
.level-badge.advanced { background: #e3f2fd; color: #1976d2; }
.level-badge.expert { background: #f3e5f5; color: #7b1fa2; }
.level-badge.master { background: #fff8e1; color: #f57f17; }

.rank {
  font-size: 0.9em;
  color: #666;
}

.empty-state {
  text-align: center;
  color: #999;
  padding: 40px 20px;
}

.nav-link {
  background: none;
  border: none;
  color: #667eea;
  cursor: pointer;
  text-decoration: underline;
  font-size: 0.9em;
}

@media (max-width: 768px) {
  .profile-header {
    flex-direction: column;
    text-align: center;
  }
  
  .quick-stats {
    margin-left: 0;
  }
  
  .overview-grid {
    grid-template-columns: 1fr;
  }
}
</style>