    box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
    padding: 30px 24px;
    margin: 20px 0;
  }
  .restyle-showcase-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    gap: 10px;
    align-items: center;
    max-width: 900px;
    margin: 18px auto 0;
  }
  .restyle-showcase-panel { position: relative; }
  .restyle-showcase-panel img {
    width: 100%;
    border-radius: 10px;
    display: block;
  }
  .restyle-showcase-panel .rs-label {
    position: absolute;
    bottom: 8px;
    left: 8px;
    background: rgba(1, 22, 30, 0.75);
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 12px;
  }
  .restyle-showcase-arrow { color: #0056b3; font-size: 26px; font-weight: 700; }
  .restyle-showcase-cta {
    display: inline-block;
    background: #28a745;
    color: #fff !important;
    padding: 12px 28px;
    border-radius: 6px;
    font-size: 17px;
    font-weight: 600;
    text-decoration: none;
  }
  @media (max-width: 700px) {
    .restyle-showcase-grid { grid-template-columns: 1fr; }
    .restyle-showcase-arrow { transform: rotate(90deg); text-align: center; }
