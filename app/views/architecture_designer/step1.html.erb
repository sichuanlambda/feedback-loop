<!-- SEO Meta Tags -->
<% content_for :title, "AI-Powered Architecture Design Analysis" %>
<% content_for :meta_description, "Generate and understand architecture in seconds. Explore architectural styles, analyze buildings with AI, and discover architecture from around the world. Free AI-powered design analysis tool." %>

<% content_for :head do %>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Architecture Helper">
  <meta name="twitter:description" content="AI-powered architecture design analysis and generation tool.">
  <meta name="robots" content="index, follow">
  <%= stylesheet_link_tag 'homepage', 'data-turbo-track': 'reload' %>
<% end %>

<!-- JSON-LD Structured Data -->
<% content_for :structured_data do %>
  <%= organization_structured_data %>
<% end %>

<% if user_signed_in? %>
  <h1 class="hp-page-title">Explore, Generate &amp; Restyle Architecture</h1>
<% else %>
<section class="hp-hero">
  <div class="hp-hero-content">
    <h1>Generate and understand architecture <span class="hp-highlight">in seconds</span></h1>
    <p class="hp-hero-lead">Perfect for…</p>
    <ul class="hp-checklist">
      <li>Creating your dream home &amp; finding inspiration</li>
      <li>Mixing influences and styles</li>
      <li>Learning about the architecture around you</li>
    </ul>
    <div class="hp-hero-ctas">
      <a href="/architecture_explorer/new?src=hero" class="hp-btn hp-btn-primary">Try It Free</a>
      <a href="/pricing?src=hero" class="hp-btn hp-btn-outline">See Pricing</a>
    </div>
    <p class="hp-hero-note">Your first analysis is free. No account needed.</p>
  </div>
  <div class="hp-hero-collage">
    <%= image_tag 'curved wooden building.png', alt: 'Modern architectural building with curved wooden facade', class: 'hp-collage-large', width: '400', height: '300', fetchpriority: 'high' %>
    <%= image_tag 'maximal grand.png', alt: 'Grand residential home with classical architecture', class: 'hp-collage-medium', width: '200', height: '300' %>
    <%= image_tag 'bohi int.png', alt: 'Bohemian interior design with unique architectural elements', class: 'hp-collage-small', width: '200', height: '150' %>
    <%= image_tag 'cathederal int.jpg', alt: 'Gothic cathedral interior with soaring arches', class: 'hp-collage-small', width: '200', height: '150' %>
  </div>
</section>
<% end %>

<!-- Restyle My Space showcase -->
<section class="hp-section">
  <%= render 'shared/section_header',
        title: 'See Your Own Home in Any Style',
        subtitle: 'Upload a photo of your house or a room, pick from 49 architecture styles, and AI re-renders your actual space in that style. Same layout, same angle, new design language.' %>
  <div class="hp-card">
    <div class="hp-restyle-grid">
      <div class="hp-restyle-panel">
        <img src="https://architecture-explorer.s3.us-east-2.amazonaws.com/uploads/restyle/a2f61e74-6504-4b15-8da2-3905a92241b7.jpg" alt="Original living room photo" width="280" height="187" loading="lazy">
        <span class="hp-restyle-label">Your room</span>
      </div>
      <div class="hp-restyle-arrow" aria-hidden="true">&rarr;</div>
      <div class="hp-restyle-panel">
        <img src="https://architecture-generated.s3.us-east-2.amazonaws.com/restyles/edb40d1b-9ee2-427d-97a5-5d029fa0de12.png" alt="Same living room restyled in Art Deco" width="280" height="187" loading="lazy">
        <span class="hp-restyle-label">Art Deco</span>
      </div>
      <div class="hp-restyle-arrow" aria-hidden="true">&rarr;</div>
      <div class="hp-restyle-panel">
        <img src="https://architecture-generated.s3.us-east-2.amazonaws.com/restyles/81248a55-4b6c-4452-a5ef-1131d71df66b.png" alt="Same living room restyled in Industrial style" width="280" height="187" loading="lazy">
        <span class="hp-restyle-label">Industrial</span>
      </div>
    </div>
    <div class="hp-restyle-cta">
      <a href="/restyle" class="hp-btn hp-btn-primary" onclick="if (window.AHTrack) AHTrack('restyle_cta_click', { src: 'homepage' });">Restyle My Space</a>
      <% unless user_signed_in? %>
        <p class="hp-restyle-note">Your first restyle is free. No account needed.</p>
      <% end %>
    </div>
  </div>
</section>

<!-- City Guides Section -->
<% if @places&.any? %>
<%
  sorted_places = @places.sort_by { |p| -p.building_analyses_in_place.count }
  featured_place = sorted_places.first
  stacked_places = sorted_places[1..2] || []
  scroll_places = sorted_places[3..] || []
%>
<section class="hp-section">
  <%= render 'shared/section_header',
        title: 'City Architecture Guides',
        subtitle: 'Notable buildings, styles, and design history in every city' %>

  <!-- Featured + 2 Stacked -->
  <div class="cg-layout">
    <% if featured_place %>
      <% fc = featured_place.building_analyses_in_place.count %>
      <% fstyles = featured_place.architectural_styles_summary.first(4) %>
      <%= link_to place_path(featured_place), class: "cg-featured" do %>
        <% if featured_place.best_representative_image.present? %>
          <img src="<%= featured_place.best_representative_image %>" alt="Architecture of <%= featured_place.name %>" width="600" height="420" loading="lazy">
        <% end %>
        <div class="cg-featured-overlay"></div>
        <div class="cg-featured-content">
          <span class="cg-featured-badge">Most Explored</span>
          <h3><%= featured_place.name %></h3>
          <p class="cg-featured-meta"><%= fc %> buildings analyzed</p>
          <% if fstyles.any? %>
            <div class="cg-featured-styles">
              <% fstyles.each do |style, _| %>
                <span class="cg-style-tag"><%= style.gsub(/\s*\d+%$/, '') %></span>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>

    <% stacked_places.each do |place| %>
      <% sc = place.building_analyses_in_place.count %>
      <% sstyles = place.architectural_styles_summary.first(3) %>
      <%= link_to place_path(place), class: "cg-stacked-card" do %>
        <div class="cg-stacked-img">
          <% if place.best_representative_image.present? %>
            <img src="<%= place.best_representative_image %>" alt="Architecture of <%= place.name %>" width="180" height="120" loading="lazy">
          <% end %>
        </div>
        <div class="cg-stacked-body">
          <h4><%= place.name %></h4>
          <p class="cg-card-meta"><%= sc %> buildings analyzed</p>
          <% if sstyles.any? %>
            <div class="cg-card-styles">
              <% sstyles.each do |style, _| %>
                <span class="cg-card-pill"><%= style.gsub(/\s*\d+%$/, '') %></span>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>

  <!-- Scrollable Row -->
  <% if scroll_places.any? %>
  <div class="cg-scroll-wrapper">
    <button type="button" class="cg-scroll-arrow left" onclick="document.getElementById('cg-scroll').scrollBy({left:-440,behavior:'smooth'})" aria-label="Scroll left">&#8249;</button>
    <div class="cg-scroll-row" id="cg-scroll">
      <% scroll_places.each do |place| %>
        <% rc = place.building_analyses_in_place.count %>
        <% rstyle = place.architectural_styles_summary.first(1) %>
        <%= link_to place_path(place), class: "cg-scroll-card" do %>
          <div class="cg-scroll-card-img">
            <% if place.best_representative_image.present? %>
              <img src="<%= place.best_representative_image %>" alt="Architecture of <%= place.name %>" width="200" height="130" loading="lazy">
            <% end %>
            <span class="cg-count-badge"><%= rc %></span>
          </div>
          <div class="cg-scroll-card-body">
            <h5><%= place.name %></h5>
            <span class="cg-scroll-meta"><%= rstyle.any? ? rstyle.first[0].gsub(/\s*\d+%$/, '') : '' %></span>
          </div>
        <% end %>
      <% end %>
    </div>
    <button type="button" class="cg-scroll-arrow right" onclick="document.getElementById('cg-scroll').scrollBy({left:440,behavior:'smooth'})" aria-label="Scroll right">&#8250;</button>
  </div>
  <% end %>

  <div class="cg-view-all">
    <%= link_to places_path, class: 'hp-btn hp-btn-primary' do %>
      View All City Guides
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <% end %>
  </div>
</section>
<% end %>

<!-- Analyze Section -->
<section class="hp-section">
  <%= render 'shared/section_header',
        title: 'AI-Powered Architecture Analysis',
        subtitle: 'Upload any building photo and get a full breakdown of its styles, history, and design details.' %>
  <div class="hp-card hp-analyze-card">
    <%= image_tag '3tilesexplanation.png', alt: 'Architecture design analysis process demonstration', width: '800', height: '400', loading: 'lazy' %>
    <div>
      <a href="/architecture_explorer/address_search" class="hp-btn hp-btn-primary">Analyze a Building</a>
    </div>
  </div>
</section>

<!-- Generate Section -->
<section class="hp-section">
  <%= render 'shared/section_header',
        title: 'Generate Your Dream Architecture',
        subtitle: 'Pick a starting point and design something new with AI.' %>
  <div class="hp-card">
    <%= form_with url: '/architecture_designer/step2', method: :get, id: 'options_form' do %>
      <div class="hp-options-row">
        <% {
          'Residential Home'   => 'residential_home.png',
          'Large Building'     => 'large_building.png',
          'Interior Design'    => 'interior_style.png',
          'Architecture Style' => 'architecture_style_new.png',
          'Courtyard Cottages' => 'courtyard_cottages.png'
        }.each do |option, image_file| %>
          <div class="hp-option">
            <%= image_tag image_file, alt: "#{option} architectural design option", width: '300', height: '340', loading: 'lazy' %>
            <%= button_tag option, type: 'button', class: 'hp-option-btn', data: { value: option } %>
          </div>
        <% end %>
      </div>
      <%= hidden_field_tag 'selected_option', nil, id: 'selected_option' %>
    <% end %>
  </div>
</section>

<!-- Community & Library gallery -->
<section class="hp-section">
  <%= render 'shared/section_header',
        title: 'Latest from the Community & Library',
        subtitle: 'Fresh AI creations and recently analyzed buildings from around the world.' %>
  <div class="hp-card">
    <div class="hp-thumb-grid">
      <% @latest_images.each do |image| %>
        <% next if image.image_url.blank? %>
        <%= link_to user_creations_path, class: 'hp-thumb', 'aria-label': 'View community creations' do %>
          <%= image_tag image.image_url, alt: 'Latest architectural creation', width: '150', height: '150', loading: 'lazy' %>
          <span class="hp-thumb-chip"><%= time_ago_in_words(image.created_at) %> ago</span>
        <% end %>
      <% end %>
      <% @building_library.each do |building| %>
        <% next if building.image_url.blank? %>
        <%= link_to architecture_explorer_show_path(building), class: 'hp-thumb', 'aria-label': 'View building analysis' do %>
          <%= image_tag building.image_url, alt: 'Building from architecture library', width: '150', height: '150', loading: 'lazy' %>
        <% end %>
      <% end %>
    </div>
    <div class="hp-gallery-ctas">
      <%= link_to 'Community Creations', user_creations_path, class: 'hp-btn hp-btn-outline' %>
      <%= link_to 'Browse the Building Library', building_library_path, class: 'hp-btn hp-btn-outline' %>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // The whole tile is clickable, not just the label button.
    document.querySelectorAll('.hp-option').forEach(function (tile) {
      tile.addEventListener('click', function () {
        var btn = this.querySelector('.hp-option-btn');
        document.getElementById('selected_option').value = btn.dataset.value;
        document.getElementById('options_form').submit();
      });
    });
  });
</script>
