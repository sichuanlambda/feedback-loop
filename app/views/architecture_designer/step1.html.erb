<!-- SEO Meta Tags -->
<% content_for :title, "Architecture Helper — AI-Powered Architecture Design Analysis" %>
<% content_for :meta_description, "Generate and understand architecture in seconds. Explore architectural styles, analyze buildings with AI, and discover architecture from around the world. Free AI-powered design analysis tool." %>

<!-- Additional SEO head content -->
<% content_for :head do %>
  <!-- Open Graph -->
  <meta property="og:title" content="Architecture Helper — AI-Powered Architecture Design Analysis">
  <meta property="og:description" content="Generate and understand architecture in seconds. Explore architectural styles, analyze buildings with AI, and discover architecture from around the world.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= request.original_url %>">
  
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Architecture Helper">
  <meta name="twitter:description" content="AI-powered architecture design analysis and generation tool.">
  
  <!-- Additional meta -->
  <meta name="robots" content="index, follow">
  <meta name="theme-color" content="#0056b3">
<% end %>

<!-- JSON-LD Structured Data -->
<% content_for :structured_data do %>
  <%= organization_structured_data %>
<% end %>

