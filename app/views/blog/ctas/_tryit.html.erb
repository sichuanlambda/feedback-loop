<%# Starts an analysis from inside the article: an address is enough (the
    server fetches the Street View photo), and a guest's first one needs no
    account. The link cards this replaces drew 11 clicks from roughly 3,000
    blog visits a month. %>
<%= form_with url: architecture_explorer_path, local: true, html: { class: 'post-cta post-tryit' } do |form| %>
  <%= hidden_field_tag :src, 'blog_tryit', id: nil %>
  <%= render 'shared/form_guard' %>
  <div class="tryit-copy">
    <strong>What style is the building on your street?</strong>
    <span>Type any address and get its architectural style, key features and history in about 30 seconds. Free, no account needed.</span>
  </div>
  <div class="tryit-row">
    <%= form.text_field :address, required: true, placeholder: 'Address or landmark', 'aria-label': 'Address or landmark', autocomplete: 'off', id: nil %>
    <button type="submit" class="btn-cta">Analyze It Free</button>
  </div>
  <div class="tryit-examples">
    Try:
    <% BlogPost::TRYIT_EXAMPLES.each do |example| %>
      <button type="button" data-tryit-example="<%= example %>"><%= example.split(',').first %></button>
    <% end %>
    <a href="/architecture_explorer/new?src=blog_tryit_photo">or upload a photo</a>
  </div>
  <script>
    (function () {
      var form = document.currentScript.closest('form');
      var field = form.querySelector('input[name=address]');
      form.querySelectorAll('[data-tryit-example]').forEach(function (chip) {
        chip.addEventListener('click', function () {
          field.value = chip.getAttribute('data-tryit-example');
          field.focus();
        });
      });
      form.addEventListener('submit', function () {
        if (window.AHTrack) AHTrack('blog_cta_click', { slug: '<%= j post.slug %>', cta: 'tryit', placement: 'tryit' });
        var button = form.querySelector('button[type=submit]');
        button.disabled = true;
        button.textContent = 'Starting…';
      });
    })();
  </script>
<% end %>
