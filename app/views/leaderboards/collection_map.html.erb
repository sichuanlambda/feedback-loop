<% content_for :title, "Architecture Style Collection Map" %>

<div class="cmap">
  <!-- Header -->
  <div class="cmap-header">
    <h1>Style Collections</h1>
    <p class="cmap-subtitle">The most collected architectural styles and the people building them</p>
    <div class="cmap-stats">
      <div class="cmap-stat"><span class="n"><%= @total_styles %></span> styles</div>
      <div class="cmap-stat"><span class="n"><%= @total_collectors %></span> collectors</div>
      <div class="cmap-stat"><span class="n"><%= number_with_delimiter(@total_buildings) %></span> buildings collected</div>
    </div>
    <%= link_to "← Back to Leaderboards", leaderboards_path, class: "cmap-back" %>
  </div>

  <!-- Style carousel -->
  <% styles_with_images = @style_collections.select { |s| @style_images[s.style_name].present? } %>
  <% if styles_with_images.any? %>
    <div class="cmap-carousel-wrap">
      <button type="button" class="cmap-arrow" id="cmap-prev" aria-label="Scroll styles left">‹</button>
      <div class="cmap-carousel" id="cmap-carousel">
        <% styles_with_images.each do |style_data| %>
          <%= link_to buildings_by_style_path(style_name: style_data.style_name), class: "cmap-slide" do %>
            <img src="<%= @style_images[style_data.style_name] %>" alt="<%= style_data.style_name.titleize %> example building" loading="lazy">
            <div class="cmap-slide-scrim"></div>
            <div class="cmap-slide-text">
              <span class="cmap-slide-name"><%= style_data.style_name.titleize %></span>
              <span class="cmap-slide-meta"><%= style_data.total_buildings %> buildings · <%= style_data.collector_count %> collectors</span>
            </div>
          <% end %>
        <% end %>
      </div>
      <button type="button" class="cmap-arrow" id="cmap-next" aria-label="Scroll styles right">›</button>
    </div>
  <% end %>

  <!-- All styles: compact ranked list -->
  <div class="cmap-panel">
    <h2>All Styles</h2>
    <% max_collectors = [@style_collections.map(&:collector_count).max.to_i, 1].max %>
    <div class="cmap-list">
      <% @style_collections.each_with_index do |style_data, i| %>
        <%= link_to buildings_by_style_path(style_name: style_data.style_name), class: "cmap-row" do %>
          <span class="cmap-rank"><%= i + 1 %></span>
          <span class="cmap-row-name"><%= style_data.style_name.titleize %></span>
          <span class="cmap-row-bar"><span class="fill" style="width: <%= (style_data.collector_count * 100.0 / max_collectors).round %>%"></span></span>
          <span class="cmap-row-count"><%= style_data.collector_count %> collectors</span>
          <span class="cmap-row-count muted"><%= style_data.total_buildings %> buildings</span>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Top collectors -->
  <div class="cmap-panel">
    <h2>Top Collectors by Style</h2>
    <div class="cmap-collectors-grid">
      <% @top_collectors_by_style.each do |style_name, collections| %>
        <div class="cmap-style-panel">
          <div class="cmap-style-panel-head">
            <h3><%= style_name.titleize %></h3>
            <%= link_to "View buildings", buildings_by_style_path(style_name: style_name) %>
          </div>
          <% collections.each_with_index do |collection, index| %>
            <div class="cmap-collector">
              <span class="cmap-medal"><%= %w[🥇 🥈 🥉][index] %></span>
              <span class="cmap-avatar"><%= (collection.user.public_name || collection.user.handle || "?")[0].upcase %></span>
              <span class="cmap-collector-name">
                <% if collection.user.handle.present? %>
                  <%= link_to (collection.user.public_name || collection.user.handle), user_profile_path(collection.user.handle) %>
                <% else %>
                  <%= collection.user.public_name || "Anonymous collector" %>
                <% end %>
              </span>
              <span class="cmap-collector-count"><%= pluralize(collection.building_count, 'building') %></span>
              <% level = collection.building_count >= 50 ? 'Master' : collection.building_count >= 25 ? 'Advanced' : collection.building_count >= 10 ? 'Intermediate' : 'Beginner' %>
              <span class="cmap-tier tier-<%= level.downcase %>"><%= level %></span>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- CTA -->
  <div class="cmap-cta">
    <h3>Start your own collection</h3>
    <p>Analyze a building to begin collecting the styles you love.</p>
    <div>
      <%= link_to "Analyze a Building", architecture_explorer_new_path, class: "cmap-btn cmap-btn-solid" %>
      <%= link_to "Explore the Library", building_library_path, class: "cmap-btn cmap-btn-outline" %>
    </div>
  </div>
</div>

<style>
  .cmap { --blue: #0056b3; --blue-dark: #004080; --blue-tint: #e8f0f9; --green: #28a745; --green-dark: #1e7e34;
          --ink: #1f2937; --ink-2: #4b5563; --muted: #8a929e; --border: #e5e7eb;
          max-width: 1100px; margin: 0 auto; padding: 32px 20px 64px; color: var(--ink); }
  .cmap a { text-decoration: none; }

  .cmap-header { text-align: center; margin-bottom: 28px; }
  .cmap-header h1 { font-size: 34px; font-weight: 800; margin: 0 0 6px; }
  .cmap-subtitle { color: var(--ink-2); margin: 0 0 14px; }
  .cmap-stats { display: flex; justify-content: center; gap: 22px; flex-wrap: wrap; margin-bottom: 10px; }
  .cmap-stat { color: var(--ink-2); font-size: 14px; }
  .cmap-stat .n { color: var(--blue); font-weight: 800; font-size: 18px; }
  .cmap-back { font-size: 13.5px; color: var(--blue); }
  .cmap-back:hover { text-decoration: underline; }

  /* Carousel */
  .cmap-carousel-wrap { position: relative; margin-bottom: 28px; }
  .cmap-carousel { display: flex; gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory;
                   scrollbar-width: none; padding: 4px 2px; }
  .cmap-carousel::-webkit-scrollbar { display: none; }
  .cmap-slide { position: relative; flex: 0 0 250px; height: 170px; border-radius: 12px; overflow: hidden;
                scroll-snap-align: start; display: block; box-shadow: 0 2px 8px rgba(0,0,0,0.10); }
  .cmap-slide img { width: 100%; height: 100%; object-fit: cover; transition: transform .35s; }
  .cmap-slide:hover img { transform: scale(1.05); }
  .cmap-slide-scrim { position: absolute; inset: 0; background: linear-gradient(rgba(0,0,0,0) 40%, rgba(0,0,0,0.72)); }
  .cmap-slide-text { position: absolute; left: 12px; right: 12px; bottom: 10px; color: #fff; }
  .cmap-slide-name { display: block; font-weight: 700; font-size: 16px; }
  .cmap-slide-meta { display: block; font-size: 12px; opacity: .9; }
  .cmap-arrow { position: absolute; top: 50%; transform: translateY(-50%); z-index: 2;
                width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--border);
                background: #fff; color: var(--blue); font-size: 20px; line-height: 1; cursor: pointer;
                box-shadow: 0 2px 6px rgba(0,0,0,0.15); }
  #cmap-prev { left: -14px; }
  #cmap-next { right: -14px; }
  .cmap-arrow:hover { background: var(--blue-tint); }

  /* Panels */
  .cmap-panel { background: #fff; border: 1px solid var(--border); border-radius: 12px; padding: 22px 24px; margin-bottom: 24px; }
  .cmap-panel h2 { font-size: 18px; font-weight: 800; margin: 0 0 14px; }

  /* Ranked list */
  .cmap-row { display: grid; grid-template-columns: 28px minmax(140px, 1fr) 2fr 110px 110px;
              gap: 12px; align-items: center; padding: 9px 10px; border-radius: 8px; color: var(--ink); }
  .cmap-row:hover { background: var(--blue-tint); }
  .cmap-rank { color: var(--muted); font-weight: 700; font-size: 13px; }
  .cmap-row-name { font-weight: 600; font-size: 14.5px; }
  .cmap-row-bar { height: 8px; border-radius: 4px; background: var(--blue-tint); overflow: hidden; }
  .cmap-row-bar .fill { display: block; height: 100%; background: var(--blue); border-radius: 4px; }
  .cmap-row-count { font-size: 13px; color: var(--ink-2); text-align: right; font-variant-numeric: tabular-nums; }
  .cmap-row-count.muted { color: var(--muted); }
  @media (max-width: 640px) {
    .cmap-row { grid-template-columns: 24px 1fr 90px; }
    .cmap-row-bar, .cmap-row-count.muted { display: none; }
  }

  /* Collectors */
  .cmap-collectors-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 16px; }
  .cmap-style-panel { border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px; }
  .cmap-style-panel-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8px; }
  .cmap-style-panel-head h3 { font-size: 15px; font-weight: 700; margin: 0; }
  .cmap-style-panel-head a { font-size: 12.5px; color: var(--blue); }
  .cmap-style-panel-head a:hover { text-decoration: underline; }
  .cmap-collector { display: flex; align-items: center; gap: 8px; padding: 6px 0; border-top: 1px solid var(--border); font-size: 13.5px; }
  .cmap-medal { width: 22px; text-align: center; }
  .cmap-avatar { width: 26px; height: 26px; border-radius: 50%; background: var(--blue); color: #fff;
                 display: inline-flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; flex-shrink: 0; }
  .cmap-collector-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cmap-collector-name a { color: var(--ink); }
  .cmap-collector-name a:hover { color: var(--blue); }
  .cmap-collector-count { color: var(--ink-2); font-size: 12.5px; white-space: nowrap; }
  .cmap-tier { font-size: 11px; font-weight: 700; border-radius: 999px; padding: 2px 8px; white-space: nowrap; }
  .tier-master { background: var(--green); color: #fff; }
  .tier-advanced { background: var(--blue); color: #fff; }
  .tier-intermediate { background: var(--blue-tint); color: var(--blue); }
  .tier-beginner { background: #eef0f2; color: var(--ink-2); }

  /* CTA */
  .cmap-cta { text-align: center; background: var(--blue); border-radius: 12px; padding: 30px 20px; color: #fff; }
  .cmap-cta h3 { font-size: 20px; font-weight: 800; margin: 0 0 4px; }
  .cmap-cta p { margin: 0 0 14px; opacity: .9; }
  .cmap-btn { display: inline-block; padding: 9px 18px; border-radius: 6px; font-weight: 700; font-size: 14px; margin: 0 5px; }
  .cmap-btn-solid { background: var(--green); color: #fff; }
  .cmap-btn-solid:hover { background: var(--green-dark); color: #fff; }
  .cmap-btn-outline { background: #fff; color: var(--blue); }
  .cmap-btn-outline:hover { background: var(--blue-tint); }
</style>

<script>
  (function() {
    var track = document.getElementById('cmap-carousel');
    if (!track) return;
    var step = 264; // slide width + gap
    document.getElementById('cmap-prev').addEventListener('click', function() {
      track.scrollBy({ left: -step * 2, behavior: 'smooth' });
    });
    document.getElementById('cmap-next').addEventListener('click', function() {
      track.scrollBy({ left: step * 2, behavior: 'smooth' });
    });
  })();
</script>
