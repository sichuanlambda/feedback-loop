<% content_for :title, "Architecture Style Collection Map" %>

<div class="collection-map-container">
  <!-- Header Section -->
  <div class="collection-map-header">
    <h1>🗺️ Style Collection Map</h1>
    <p class="subtitle">Discover the most popular architectural styles and their top collectors</p>
    
    <!-- Navigation Back to Leaderboards -->
    <div class="back-navigation">
      <%= link_to leaderboards_path, class: "back-link" do %>
        ← Back to Leaderboards
      <% end %>
    </div>
  </div>

  <!-- Style Overview Grid -->
  <div class="style-overview">
    <h2>Popular Architectural Styles</h2>
    
    <div class="styles-grid">
      <% @style_collections.each do |style_data| %>
        <div class="style-card">
          <div class="style-info">
            <h3 class="style-name"><%= style_data.style_name.titleize %></h3>
            <div class="style-stats">
              <div class="stat">
                <span class="stat-value"><%= style_data.collector_count %></span>
                <span class="stat-label">Collectors</span>
              </div>
              <div class="stat">
                <span class="stat-value"><%= style_data.total_buildings %></span>
                <span class="stat-label">Buildings</span>
              </div>
            </div>
          </div>
          
          <div class="style-actions">
            <%= link_to buildings_by_style_path(style_name: style_data.style_name), 
                        class: "btn-explore-style" do %>
              Explore Style →
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Top Collectors by Style -->
  <div class="top-collectors-section">
    <h2>Top Collectors by Style</h2>
    
    <% @top_collectors_by_style.each do |style_name, collections| %>
      <div class="style-leaderboard">
        <div class="style-leaderboard-header">
          <h3><%= style_name.titleize %></h3>
          <%= link_to buildings_by_style_path(style_name: style_name), 
                      class: "view-all-buildings" do %>
            View All Buildings
          <% end %>
        </div>
        
        <div class="collectors-grid">
          <% collections.each_with_index do |collection, index| %>
            <div class="collector-card rank-<%= index + 1 %>">
              <div class="rank-badge">
                <span class="rank-number">#<%= index + 1 %></span>
                <% if index == 0 %>
                  <span class="trophy">👑</span>
                <% elsif index == 1 %>
                  <span class="trophy">🥈</span>
                <% elsif index == 2 %>
                  <span class="trophy">🥉</span>
                <% end %>
              </div>
              
              <div class="collector-info">
                <div class="collector-avatar">
                  <%= (collection.user.public_name || collection.user.handle || "?")[0].upcase %>
                </div>
                <div class="collector-details">
                  <span class="collector-name">
                    <%= collection.user.public_name || collection.user.handle %>
                  </span>
                  <span class="collection-count">
                    <%= pluralize(collection.building_count, 'building') %>
                  </span>
                </div>
              </div>
              
              <div class="completion-level">
                <% completion_level = collection.building_count >= 50 ? 'master' : 
                                      collection.building_count >= 25 ? 'advanced' : 
                                      collection.building_count >= 10 ? 'intermediate' : 'beginner' %>
                <span class="level-badge level-<%= completion_level %>">
                  <%= completion_level.capitalize %>
                </span>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Collection Progress Visualization -->
  <div class="collection-progress-viz">
    <h2>Collection Progress Landscape</h2>
    <p>Each bar represents the distribution of collectors by style</p>
    
    <div class="progress-chart">
      <% @style_collections.each do |style_data| %>
        <div class="style-progress-bar">
          <div class="style-label">
            <span class="style-name-short"><%= style_data.style_name.titleize.split(' ').first %></span>
          </div>
          <div class="progress-bar-container">
            <div class="progress-bar" style="width: <%= (style_data.collector_count.to_f / @style_collections.first.collector_count * 100).round(1) %>%">
              <span class="progress-label"><%= style_data.collector_count %></span>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Call to Action -->
  <div class="collection-cta">
    <h3>Start Your Own Collection 🎨</h3>
    <p>Find your favorite architectural style and start building your collection!</p>
    <div class="cta-buttons">
      <%= link_to "Explore Buildings", building_library_path, class: "btn btn-primary" %>
      <%= link_to "Analyze a Building", architecture_explorer_new_path, class: "btn btn-secondary" %>
    </div>
  </div>
</div>

<!-- Collection Map Styles -->
