<% content_for :title, "Identify a Building's Architectural Style from a Photo" %>
<% content_for :meta_description, "Upload or snap a photo of any building and get its architectural styles, notable features, and history in seconds. First analysis free, no account needed." %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Architecture Helper Explore</title>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-M4TLZ8N6CC"></script>
    <script>
