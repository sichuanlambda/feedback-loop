<%# Reusable "Restyle My Space" banner.
    Locals: style (optional canonical style name to prefill), src (tracking label) %>
<% style_label = local_assigns[:style].presence %>
<% src_label = local_assigns[:src] || 'unknown' %>
<div style="background: #0056b3; border-radius: 12px; padding: 18px 22px; margin: 18px 0; display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap;">
  <div>
    <div style="color: #fff; font-weight: 700; font-size: 16.5px;">
      <% if style_label %>
        Like <%= style_label %>? See your own home in it.
      <% else %>
        See your own home in any of these styles.
      <% end %>
    </div>
    <div style="color: #d6e6f7; font-size: 13.5px; margin-top: 2px;">
      <% if style_label %>
        Upload a photo of your house or a room and AI re-renders it in <%= style_label %> style.
      <% else %>
        Upload a photo of your house or a room and AI re-renders it in the style you pick — same layout, new design language.
      <% end %>
    </div>
  </div>
  <a href="<%= style_label ? restyle_path(style: style_label) : restyle_path %>"
     onclick="if (window.AHTrack) AHTrack('restyle_cta_click', { src: '<%= j src_label %>'<%= raw(", style: '#{j style_label}'") if style_label %> });"
     style="background: #28a745; color: #fff; padding: 10px 22px; border-radius: 6px; font-weight: 600; text-decoration: none; white-space: nowrap;">
    Restyle My Space &rarr;
  </a>
</div>
