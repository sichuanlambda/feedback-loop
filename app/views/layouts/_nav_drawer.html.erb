<%# Full-screen mobile navigation drawer, opened by the hamburger in the
    navbar (web) or mobile_nav (native shell). Grouped: Create / Explore /
    account. Toggled by layout JS via the .ah-drawer-open class. %>
<div id="ah-drawer" class="ah-drawer" aria-hidden="true">
  <div class="ah-drawer-header">
    <a href="/architecture_designer/step1" style="font-size: 16px; font-weight: 600; color: #01161e; text-decoration: none;">Architecture Helper</a>
    <button type="button" class="ah-drawer-close" data-ah-drawer-close aria-label="Close menu">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#01161e" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>

  <div class="ah-drawer-body">
    <div class="ah-drawer-label">Create</div>
    <a href="/architecture_explorer/address_search" class="ah-drawer-row">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0056b3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/></svg>
      <span><strong>Analyze a building</strong><small>Photo or address &rarr; styles &amp; history</small></span>
    </a>
    <a href="/architecture_designer/step1" class="ah-drawer-row">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0056b3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1"/></svg>
      <span><strong>Generate a design</strong><small>Dream up new architecture with AI</small></span>
    </a>
    <a href="/restyle" class="ah-drawer-row">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0056b3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-8 9 8M5 9.5V21h14V9.5"/><path d="M9.5 15.5l2-2 3 3"/></svg>
      <span><strong>Restyle my space</strong><small>Your home in any style<% unless user_signed_in? %> &mdash; 1st free<% end %></small></span>
    </a>

    <div class="ah-drawer-label" style="margin-top: 14px;">Explore</div>
    <div class="ah-drawer-grid">
      <a href="/building_library" class="ah-drawer-cell">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#01161e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21V10l4-3 4 3v11M4 21h16M12 21V6l4-3 4 3v15"/></svg>
        Library
      </a>
      <a href="/styles" class="ah-drawer-cell">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#01161e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="8" height="8" rx="1"/><rect x="13" y="3" width="8" height="8" rx="1"/><rect x="3" y="13" width="8" height="8" rx="1"/><rect x="13" y="13" width="8" height="8" rx="1"/></svg>
        Styles A&ndash;Z
      </a>
      <a href="/places" class="ah-drawer-cell">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#01161e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
        City Guides
      </a>
      <a href="/architecture_explorer/map" class="ah-drawer-cell">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#01161e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 20l-6-2V4l6 2m0 14l6-2m-6 2V6m6 12l6 2V6l-6-2m0 14V4M9 6l6-2"/></svg>
        Map
      </a>
      <a href="/user_creations" class="ah-drawer-cell">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#01161e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="14" rx="2"/><circle cx="8.5" cy="9.5" r="1.5"/><path d="M21 14l-4.5-4.5L9 17"/></svg>
        Creations
      </a>
      <a href="<%= leaderboards_path %>" class="ah-drawer-cell">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#01161e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="9" r="6"/><path d="M9 14l-2 7 5-2.5L17 21l-2-7"/></svg>
        Leaderboards
      </a>
    </div>
    <a href="/style-finder" class="ah-drawer-quiz">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6c757d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 16v.01M9.5 9a2.5 2.5 0 1 1 3.9 2.06c-.86.57-1.4 1.02-1.4 1.94"/></svg>
      Not sure what you like? <span style="color: #0056b3; font-weight: 600;">Take the style quiz</span>
    </a>

    <div class="ah-drawer-footer">
      <% if !user_signed_in? || current_user.subscription_status != 'active' %>
        <a href="<%= pricing_path(src: 'nav_drawer') %>" class="ah-drawer-upgrade">
          <span>
            <strong>Go unlimited</strong>
            <small>Unlimited analyses, designs &amp; restyles</small>
          </span>
          <span class="ah-drawer-upgrade-btn">Upgrade</span>
        </a>
      <% end %>
      <% if user_signed_in? %>
        <div class="ah-drawer-account">
          <span class="ah-avatar"><%= (current_user.public_name.presence || current_user.handle.presence || current_user.email)[0].upcase %></span>
          <span class="ah-drawer-account-links">
            <a href="/profile">Profile</a>
            <a href="/account">Account</a>
            <% if current_user.admin? %><a href="<%= admin_dashboard_path %>" style="color: #b8860b;">Admin</a><% end %>
            <%= link_to 'Log out', custom_sign_out_path, method: :delete %>
          </span>
        </div>
      <% else %>
        <div style="display: flex; gap: 10px;">
          <a href="<%= new_user_session_path %>" class="ah-drawer-auth-secondary">Log in</a>
          <a href="<%= new_user_registration_path %>" class="ah-drawer-auth-primary">Sign up free</a>
        </div>
      <% end %>
    </div>
  </div>
</div>
