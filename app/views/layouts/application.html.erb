<div class="container mt-4">
  <%= yield %>
</div>
<script>
  // Nav dropdowns (Explore, account) + mobile drawer. Vanilla JS, no Bootstrap.
  (function() {
    function closeMenus() {
      document.querySelectorAll('.ah-menu.ah-open').forEach(function(m) { m.classList.remove('ah-open'); });
      document.querySelectorAll('[data-ah-menu]').forEach(function(b) { b.setAttribute('aria-expanded', 'false'); });
    }
    document.querySelectorAll('[data-ah-menu]').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        var menu = document.getElementById(btn.getAttribute('data-ah-menu'));
        var wasOpen = menu.classList.contains('ah-open');
        closeMenus();
        if (!wasOpen) { menu.classList.add('ah-open'); btn.setAttribute('aria-expanded', 'true'); }
      });
    });
    document.addEventListener('click', closeMenus);
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') { closeMenus(); closeDrawer(); } });

    var drawer = document.getElementById('ah-drawer');
    function closeDrawer() {
      if (!drawer) return;
      drawer.classList.remove('ah-drawer-open');
      drawer.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }
    document.querySelectorAll('[data-ah-drawer-open]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        if (!drawer) return;
        drawer.classList.add('ah-drawer-open');
        drawer.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      });
    });
    document.querySelectorAll('[data-ah-drawer-close]').forEach(function(btn) {
      btn.addEventListener('click', closeDrawer);
    });
  })();
</script>

<!-- Toast Notifications for Gamification -->
<%= render 'shared/toast_notifications' %>

<!-- Client-side Analytics Tracker -->
<script>
  window.AHTrack = function(eventType, metadata) {
    fetch('/api/events', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ 
        event_type: eventType, 
        metadata: metadata || {} 
      })
    }).catch(function() {}); // Silently fail to avoid breaking the page
  };
</script>

</body>
</html>