          </button>
          <span class="ah-menu ah-menu-explore" id="ah-explore-menu">
            <a href="/building_library" class="ah-menu-item">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0056b3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21V10l4-3 4 3v11M4 21h16M12 21V6l4-3 4 3v15"/></svg>
